# Public settings only. Never use service_role, sb_secret_, database password,
# private access tokens or SMTP credentials in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Set only on the dedicated Premium deployment.
VITE_ELEVA_PREMIUM=false
